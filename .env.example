NODE_ENV=production
PORT=8080
DATABASE_PATH=./data/linguaai.sqlite
ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN.com,capacitor://localhost,http://localhost
TRUST_PROXY=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MODELS=qwen2.5:0.5b,qwen2.5:1.5b,qwen2.5:3b,qwen2.5:7b
LOCAL_AI_ENABLED=true
ONLINE_FALLBACK=true
GEMINI_API_KEY=
# Override if your Gemini API project uses a different available model name.
GEMINI_MODEL=gemini-3.6-flash
TTS_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=
VITE_API_URL=
VITE_ENABLE_WEB_SPEECH=true
